#!/bin/sh
set -eu

# Finder preferences belong to the active desktop user, including on admin-assisted installs.
uid=$(/usr/bin/stat -f %u /dev/console)
if [ "$uid" = 0 ] || ! /bin/launchctl print "gui/$uid" >/dev/null 2>&1; then
    exit 0
fi

as_desktop_user() {
    /bin/launchctl asuser "$uid" /usr/bin/sudo -H -u "#$uid" -- "$@"
}

app=/Applications/f2s.app
extension_id=local.finder-to-iterm.FinderMenu
as_desktop_user /usr/bin/pluginkit -a "$app/Contents/PlugIns/FinderMenu.appex"
# Preserve an explicit decision to disable the extension on a later upgrade.
if ! as_desktop_user /usr/bin/pluginkit -m -i "$extension_id" | /usr/bin/grep -q '^[-]'; then
    as_desktop_user /usr/bin/pluginkit -e use -i "$extension_id"
fi
if ! as_desktop_user "$app/Contents/MacOS/FinderToITerm" --install-toolbar; then
    echo '请在 Finder 的自定工具栏中移除旧版 f2s 应用快捷方式。' >&2
fi
