<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>f2s</title>
    <welcome file="Welcome.html"/>
    <conclusion file="Conclusion.html"/>
    <options customize="never" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true" enable_currentUserHome="false" enable_anywhere="false"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="11.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="app"/>
    </choices-outline>
    <choice id="app" visible="false">
        <pkg-ref id="local.finder-to-iterm.pkg"/>
    </choice>
    <pkg-ref id="local.finder-to-iterm.pkg" auth="root">FinderToITerm.pkg</pkg-ref>
</installer-gui-script>
